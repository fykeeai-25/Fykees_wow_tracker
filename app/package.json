{
  "name": "azerothtracker",
  "productName": "AzerothTracker",
  "version": "0.1.0",
  "private": true,
  "description": "AzerothTracker - companion app for World of Warcraft: Forever",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-vite build && electron-builder --win portable --publish never",
    "check:addon": "node scripts/check-addon.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/luaparse": "^0.2.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
